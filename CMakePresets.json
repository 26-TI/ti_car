{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 27,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "Debug",
			"displayName": "Debug（-O0 -g）",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "Release",
			"displayName": "Release（-Ofast）",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "RelWithDebInfo",
			"displayName": "RelWithDebInfo（-Ofast -g）",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Debug",
			"configurePreset": "Debug"
		},
		{
			"name": "Release",
			"configurePreset": "Release"
		},
		{
			"name": "RelWithDebInfo",
			"configurePreset": "RelWithDebInfo"
		}
	]
}
